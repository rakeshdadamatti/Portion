# ─── Portion UI environment ────────────────────────────────────────────────
# Copy to `.env` (or `.env.local`) and adjust. Only VITE_* variables reach the
# browser bundle; never put secrets here — this file is committed.

# Base URL for every REST call. The default is a same-origin path that the Vite
# dev server proxies to http://localhost:5000 (see `server.proxy` in
# vite.config.ts), which is why no CORS configuration is required.
VITE_API_BASE_URL=/api/v1

# Cadence in milliseconds for the auto-refresh / sync polling hooks. Values
# below 500 are clamped.
VITE_POLL_INTERVAL_MS=5000
